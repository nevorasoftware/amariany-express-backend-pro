# Configuración de Servidor
PORT=5000
NODE_ENV=development

# Configuración de Base de Datos PostgreSQL (para Railway)
DATABASE_URL="postgresql://postgres:password@localhost:5432/amairany_express?schema=public"

# Clave Secreta para Tokens JWT (Login Admin)
JWT_SECRET="amairany_express_super_secret_jwt_key_2025"

# Clave de API de Google Gemini (Opcional - para extracción IA gratis mediante Google AI Studio)
# Obtén tu API key gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=""

# Credenciales de Administrador por defecto para Seeding
ADMIN_EMAIL="admin@amairanyexpress.com"
ADMIN_PASSWORD="Admin123!"
